# Deliberately exaggerated, springy animations for Hyprland.
# Animation speeds use deciseconds (10 = about one second).
animations {
    enabled = true

    # Curves with overshoot make openings, focus changes and workspace motion feel lively.
    bezier = easeOutQuint, 0.23, 1, 0.32, 1
    bezier = easeInOutCubic, 0.65, 0.05, 0.36, 1
    bezier = linear, 0, 0, 1, 1
    bezier = almostLinear, 0.5, 0.5, 0.75, 1.0
    bezier = quick, 0.15, 0, 0.1, 1
    bezier = overshoot, 0.34, 1.56, 0.64, 1
    bezier = anticipate, 0.36, 0, 0.66, -0.56
    bezier = overshootInOut, 0.68, -0.6, 0.32, 1.6
    bezier = smoothOut, 0.16, 1, 0.3, 1

    animation = global, 1, 10, default
    animation = border, 1, 8, overshoot

    # Windows pop in from noticeably smaller sizes and overshoot into place.
    animation = windows, 1, 9, overshoot, popin 65%
    animation = windowsIn, 1, 10, overshoot, popin 60%
    animation = windowsOut, 1, 7, anticipate, popin 82%
    animation = windowsMove, 1, 8, overshoot

    # Pronounced but still smooth fades.
    animation = fadeIn, 1, 7, smoothOut
    animation = fadeOut, 1, 6, anticipate
    animation = fade, 1, 5, quick
    animation = fadeSwitch, 1, 6, smoothOut

    # Layers such as floating menus and shell surfaces animate more visibly.
    animation = layers, 1, 9, overshoot, popin 80%
    animation = layersIn, 1, 10, overshoot, popin 75%
    animation = layersOut, 1, 7, anticipate, fade
    animation = fadeLayersIn, 1, 7, smoothOut
    animation = fadeLayersOut, 1, 6, anticipate

    # Workspace switches travel a larger distance with a springy settle.
    animation = workspaces, 1, 10, overshootInOut, slidefade 30%
    animation = workspacesIn, 1, 9, overshoot, slidefade 30%
    animation = workspacesOut, 1, 9, anticipate, slidefade 30%
    animation = specialWorkspace, 1, 10, overshootInOut, slidefadevert 25%
    animation = specialWorkspaceIn, 1, 10, overshoot, slidefadevert 25%
    animation = specialWorkspaceOut, 1, 8, anticipate, slidefadevert 25%
}
